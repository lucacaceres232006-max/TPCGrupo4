@model List<Dominio.PoliticaPrestamo>

@{
    ViewBag.Title = "Políticas de préstamo";
}

<main class="container py-4" aria-labelledby="titulo-politicas">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 id="titulo-politicas">Políticas de préstamo</h1>
            <p class="text-muted mb-0">Configurá las condiciones y topes de retiro para las categorías de socios.</p>
        </div>
        <a href="@Url.Action("Create", "PoliticaPrestamo")" class="btn btn-success">
            Nueva política
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">
            <strong>Error:</strong> @TempData["Error"]
        </div>
    }

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success" role="status" aria-live="polite">
            @TempData["Exito"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <caption class="visually-hidden">Listado de políticas de préstamo con sus plazos, límites de ejemplares y renovaciones</caption>
                <thead class="table-dark">
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Descripción</th>
                        <th scope="col">Días de duración</th>
                        <th scope="col">Tope de ejemplares</th>
                        <th scope="col">Límite de renovaciones</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <th scope="row" class="fw-semibold">@item.Descripcion</th>
                                <td>@item.DiasDuracion días</td>
                                <td>@item.CantidadMaximaEjemplares libros</td>
                                <td>@item.LimiteRenovaciones</td>
                                <td class="text-end text-nowrap">
                                    <a href="@Url.Action("Edit", "PoliticaPrestamo", new { id = item.Id })"
                                       class="btn btn-warning btn-sm me-1"
                                       aria-label="Modificar política @item.Descripcion">
                                        Modificar
                                    </a>
                                    <a href="@Url.Action("Delete", "PoliticaPrestamo", new { id = item.Id })"
                                       class="btn btn-danger btn-sm"
                                       aria-label="Eliminar política @item.Descripcion"
                                       onclick="return confirm('¿Estás seguro de que querés eliminar esta política?');">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4" role="status" aria-live="polite">
                                No hay políticas de préstamo registradas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>