@model Dominio.Libro

@{
    ViewBag.Title = "Detalle del libro";
}

<main class="container py-4" aria-labelledby="titulo-detalle">
    <h1 id="titulo-detalle" class="h2">Detalle del libro</h1>
    <hr />

    <div class="card shadow-sm">
        <div class="card-body">

            <h2 class="h3">@Model.Titulo</h2>

            <p class="mb-1">
                <strong>ISBN:</strong> @Model.ISBN
            </p>

            <p class="mb-1">
                <strong>Editorial:</strong>
                @(Model.Editorial != null ? Model.Editorial.Nombre : "Sin editorial")
            </p>

            <p class="mb-3">
                <strong>Año de edición:</strong> @Model.AnioEdicion
            </p>

            <hr />

            <h3 class="h4">Autores</h3>

            @if (Model.Autores != null && Model.Autores.Count > 0)
            {
                <ul>
                    @foreach (var autor in Model.Autores)
                    {
                        <li>@autor.Nombre @autor.Apellido</li>
                    }
                </ul>
            }
            else
            {
                <p>No hay autores registrados.</p>
            }

            <hr />

            <h3 class="h4">Géneros</h3>

            @if (Model.Categorias != null && Model.Categorias.Count > 0)
            {
                <ul>
                    @foreach (var categoria in Model.Categorias)
                    {
                        <li>@categoria.Descripcion</li>
                    }
                </ul>
            }
            else
            {
                <p>No hay géneros registrados.</p>
            }

            <hr />

            <h3 class="h4">Ejemplares físicos</h3>

            @if (Model.Ejemplares != null && Model.Ejemplares.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle border">
                        <caption class="visually-hidden">Listado de ejemplares físicos asociados al libro @Model.Titulo</caption>
                        <thead class="table-dark">
                            <tr>
                                <th scope="col">Código de inventario</th>
                                <th scope="col">Estado</th>
                                <th scope="col">Observaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ejemplar in Model.Ejemplares)
                            {
                                <tr>
                                    <th scope="row" class="fw-semibold">@ejemplar.CodigoInventario</th>
                                    <td>@ejemplar.Estado</td>
                                    <td>@(string.IsNullOrWhiteSpace(ejemplar.Observaciones) ? "Sin observaciones" : ejemplar.Observaciones)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p>No hay ejemplares registrados para este libro.</p>
            }

            <hr />

            <div class="d-flex gap-2">
                <a href="@Url.Action("Edit", "Libros", new { id = Model.Id })"
                   class="btn btn-warning"
                   aria-label="Modificar libro @Model.Titulo">
                    Modificar libro
                </a>
                <a href="@Url.Action("Index", "Libros")"
                   class="btn btn-secondary">
                    Volver al catálogo
                </a>
            </div>

        </div>
    </div>
</main>