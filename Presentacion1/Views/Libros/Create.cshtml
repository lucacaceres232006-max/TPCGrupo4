@model Dominio.Libro
@using System.Linq

@{
    ViewBag.Title = "Registrar libro";
}

<main class="container py-4" aria-labelledby="titulo-registrar">
    <h1 id="titulo-registrar" class="h2">Registrar nuevo libro</h1>
    <p id="instrucciones-alta">
        Completá los datos para agregar un libro al catálogo. Todos los campos marcados con <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden">asterisco</span> son obligatorios.
    </p>

    <hr />

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">
            <strong>Error al registrar el libro:</strong> @ViewBag.Error
        </div>
    }

    @using (Html.BeginForm("Create", "Libros", FormMethod.Post, new { aria_describedby = "instrucciones-alta" }))
    {
        <div class="form-group mb-3">
            <label for="txtTitulo" class="form-label fw-semibold">
                Título <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <input type="text" id="txtTitulo" name="Titulo" class="form-control"
                   value="@(Model != null ? Model.Titulo : "")" required aria-required="true" />
        </div>

        <div class="form-group mb-3">
            <label for="txtISBN" class="form-label fw-semibold">
                ISBN <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <input type="text" id="txtISBN" name="ISBN" class="form-control"
                   value="@(Model != null ? Model.ISBN : "")" required aria-required="true" />
        </div>

        <div class="form-group mb-3">
            <label for="ddlEditorial" class="form-label fw-semibold">
                Editorial <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <select id="ddlEditorial" name="IdEditorial" class="form-control form-select" required aria-required="true">
                <option value="">Seleccionar editorial</option>

                @if (ViewBag.Editoriales != null)
                {
                    foreach (var editorial in ViewBag.Editoriales)
                    {
                        bool seleccionada = Model != null && Model.Editorial != null && Model.Editorial.Id == editorial.Id;
                        <option value="@editorial.Id" @(seleccionada ? "selected" : "")>@editorial.Nombre</option>
                    }
                }
            </select>
        </div>

        <div class="form-group mb-3">
            <label for="txtAnioEdicion" class="form-label fw-semibold">
                Año de edición <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <input type="number" id="txtAnioEdicion" name="AnioEdicion" class="form-control"
                   value="@(Model != null && Model.AnioEdicion > 0 ? Model.AnioEdicion.ToString() : "")" required aria-required="true" />
        </div>

        <fieldset class="mb-3 p-3 border rounded" aria-describedby="ayuda-autores">
            <legend class="fs-6 fw-semibold mb-2">
                Autores <span class="text-danger" aria-hidden="true">*</span>
            </legend>
            <div id="ayuda-autores" class="form-text text-muted mb-2">
                Marcá con barra espaciadora o clic uno o más autores para este libro.
            </div>
            <div class="row">
                @if (ViewBag.Autores != null)
                {
                    foreach (var autor in ViewBag.Autores)
                    {
                        bool marcado = Model != null && Model.Autores != null && Model.Autores.Any(a => a.Id == autor.Id);
                        <div class="col-md-6 mb-1">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="IdsAutores"
                                       id="chkAutor_@autor.Id"
                                       value="@autor.Id"
                                       @(marcado ? "checked" : "") />
                                <label class="form-check-label" for="chkAutor_@autor.Id">
                                    @autor.Nombre @autor.Apellido
                                </label>
                            </div>
                        </div>
                    }
                }
            </div>
        </fieldset>

        <fieldset class="mb-3 p-3 border rounded" aria-describedby="ayuda-categorias">
            <legend class="fs-6 fw-semibold mb-2">
                Géneros <span class="text-danger" aria-hidden="true">*</span>
            </legend>
            <div id="ayuda-categorias" class="form-text text-muted mb-2">
                Marcá con barra espaciadora o clic uno o más géneros literarios.
            </div>
            <div class="row">
                @if (ViewBag.Categorias != null)
                {
                    foreach (var categoria in ViewBag.Categorias)
                    {
                        bool marcado = Model != null && Model.Categorias != null && Model.Categorias.Any(c => c.Id == categoria.Id);
                        <div class="col-md-6 mb-1">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="IdsCategorias"
                                       id="chkCat_@categoria.Id"
                                       value="@categoria.Id"
                                       @(marcado ? "checked" : "") />
                                <label class="form-check-label" for="chkCat_@categoria.Id">
                                    @categoria.Descripcion
                                </label>
                            </div>
                        </div>
                    }
                }
            </div>
        </fieldset>

        <hr />

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                Registrar libro
            </button>

            <a href="@Url.Action("Index", "Libros")" class="btn btn-secondary">
                Cancelar y volver al catálogo
            </a>
        </div>
    }
</main>