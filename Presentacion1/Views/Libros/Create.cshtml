@model Dominio.Libro
@using System.Linq

@{
    ViewBag.Title = "Registrar libro";
}

<script>
    window.listaAutoresDisponibles = @Html.Raw(Json.Encode(ViewBag.Autores));
    window.listaCategoriasDisponibles = @Html.Raw(Json.Encode(ViewBag.Categorias));
</script>

<main class="container py-4" aria-labelledby="titulo-registrar">
    <h1 id="titulo-registrar" class="h2">Registrar nuevo libro</h1>
    <p id="instrucciones-alta">
        Completá los datos para agregar un libro al catálogo. Todos los campos marcados con <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden">asterisco</span> son obligatorios.
    </p>

    <hr />

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">
            <strong>Error al registrar el libro:</strong> @ViewBag.Error
        </div>
    }

    @using (Html.BeginForm("Create", "Libros", FormMethod.Post, new { aria_describedby = "instrucciones-alta" }))
    {
        <div class="form-group mb-3">
            <label for="txtTitulo" class="form-label fw-semibold">
                Título <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <input type="text" id="txtTitulo" name="Titulo" class="form-control"
                   value="@(Model != null ? Model.Titulo : "")" required aria-required="true" />
        </div>

        <div class="form-group mb-3">
            <label for="txtISBN" class="form-label fw-semibold">
                ISBN <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <input type="text" id="txtISBN" name="ISBN" class="form-control"
                   value="@(Model != null ? Model.ISBN : "")" required aria-required="true" />
        </div>

        <div class="form-group mb-3">
            <label for="ddlEditorial" class="form-label fw-semibold">
                Editorial <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <select id="ddlEditorial" name="IdEditorial" class="form-control form-select" required aria-required="true">
                <option value="">Seleccionar editorial</option>

                @if (ViewBag.Editoriales != null)
                {
                    foreach (var editorial in ViewBag.Editoriales)
                    {
                        bool seleccionada = Model != null && Model.Editorial != null && Model.Editorial.Id == editorial.Id;
                        <option value="@editorial.Id" @(seleccionada ? "selected" : "")>@editorial.Nombre</option>
                    }
                }
            </select>
        </div>

        <div class="form-group mb-3">
            <label for="txtAnioEdicion" class="form-label fw-semibold">
                Año de edición <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <input type="number" id="txtAnioEdicion" name="AnioEdicion" class="form-control"
                   value="@(Model != null && Model.AnioEdicion > 0 ? Model.AnioEdicion.ToString() : "")" required aria-required="true" />
        </div>

        <div class="mb-3 position-relative">
            <label for="buscadorAutores" class="form-label fw-semibold">
                Autor <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <input type="text" id="buscadorAutores" class="form-control" placeholder="Escribí para buscar autor..." autocomplete="off" />
            <div id="resultadosAutores" class="list-group position-absolute shadow-sm w-100" style="z-index: 1000; display: none;"></div>

            <div class="mt-1">
                <a href="#" data-bs-toggle="modal" data-bs-target="#modalAutores">Ver lista completa de autores</a>
            </div>

            <div id="contenedorAutoresSeleccionados" class="mt-2"></div>
        </div>

        <div class="mb-3 position-relative">
            <label for="buscadorCategorias" class="form-label fw-semibold">
                Género <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <input type="text" id="buscadorCategorias" class="form-control" placeholder="Escribí para buscar género..." autocomplete="off" />
            <div id="resultadosCategorias" class="list-group position-absolute shadow-sm w-100" style="z-index: 1000; display: none;"></div>

            <div class="mt-1">
                <a href="#" data-bs-toggle="modal" data-bs-target="#modalCategorias">Ver lista completa de géneros</a>
            </div>

            <div id="contenedorCategoriasSeleccionados" class="mt-2"></div>
        </div>

        <hr />

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                Registrar libro
            </button>

            <a href="@Url.Action("Index", "Libros")" class="btn btn-secondary">
                Cancelar y volver al catálogo
            </a>
        </div>
    }
</main>

<div class="modal fade" id="modalAutores" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Seleccionar Autores</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @if (ViewBag.Autores != null)
                {
                    foreach (var autor in ViewBag.Autores)
                    {
                        bool marcado = Model != null && Model.Autores != null && Model.Autores.Any(a => a.Id == autor.Id);
                        <div class="form-check mb-2">
                            <input class="form-check-input chk-modal-autores" type="checkbox" value="@autor.Id" id="chk_modal_autores_@autor.Id" @(marcado ? "checked" : "") />
                            <label class="form-check-label" for="chk_modal_autores_@autor.Id">
                                @autor.Nombre @autor.Apellido
                            </label>
                        </div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCategorias" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Seleccionar Géneros</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @if (ViewBag.Categorias != null)
                {
                    foreach (var categoria in ViewBag.Categorias)
                    {
                        bool marcado = Model != null && Model.Categorias != null && Model.Categorias.Any(c => c.Id == categoria.Id);
                        <div class="form-check mb-2">
                            <input class="form-check-input chk-modal-categorias" type="checkbox" value="@categoria.Id" id="chk_modal_categorias_@categoria.Id" @(marcado ? "checked" : "") />
                            <label class="form-check-label" for="chk_modal_categorias_@categoria.Id">
                                @categoria.Descripcion
                            </label>
                        </div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/libros-buscador.js"></script>