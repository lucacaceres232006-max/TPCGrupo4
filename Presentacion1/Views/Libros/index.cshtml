
@model List<Dominio.Libro>

@{
    ViewBag.Title = "Catálogo de libros";
}

<div class="container py-4">
    <h1>Catálogo de libros</h1>
    <p>Consultá los libros registrados en la biblioteca.</p>

    <form action="@Url.Action("Index", "Libros")" method="get" class="mb-4">
        <div class="input-group">
            <input type="text"
                   name="buscar"
                   class="form-control"
                   placeholder="Buscar libro por título..."
                   value="@ViewBag.Buscar" />

            <button type="submit" class="btn btn-primary">
                Buscar
            </button>

            <a href="@Url.Action("Index", "Libros")"
               class="btn btn-secondary">
                Limpiar
            </a>
        </div>
    </form>


    <div class="row">
        @if (Model != null && Model.Count > 0)
        {
            foreach (var libro in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h3 class="card-title">@libro.Titulo</h3>

                            <p>
                                <strong>Autor:</strong>
                                @string.Join(", ", libro.Autores.Select(a => a.Nombre + " " + a.Apellido))
                            </p>

                            <p>
                                <strong>Categoría:</strong>
                                @string.Join(", ", libro.Categorias.Select(c => c.Descripcion))
                            </p>

                            <p>
                                <strong>Editorial:</strong>
                                @(libro.Editorial != null ? libro.Editorial.Nombre : "Sin editorial")
                            </p>

                            <p><strong>Año:</strong> @libro.AnioEdicion</p>
                            <p><strong>ISBN:</strong> @libro.ISBN</p>

                            <p>
                                <strong>Total de ejemplares:</strong>
                                @(libro.Ejemplares != null ? libro.Ejemplares.Count : 0)
                            </p>

                            <p>
                                <strong>Disponibles:</strong>
                                @(libro.Ejemplares != null
        ? libro.Ejemplares.Count(e => e.Estado == "Disponible")
        : 0)
                            </p>

                            <a href="@Url.Action("Edit", "Libros", new { id = libro.Id })"
                               class="btn btn-warning">
                                Modificar
                            </a>
                            <a href="@Url.Action("Delete", "Libros", new { id = libro.Id })"
                               class="btn btn-danger"
                               onclick="return confirm('¿Estás seguro de que querés eliminar este libro?');">
                                Eliminar
                            </a>

                            <a href="@Url.Action("Details", "Libros", new { id = libro.Id })"
                               class="btn btn-info">
                                Ver detalle
                            </a>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            if (!string.IsNullOrEmpty(ViewBag.Buscar))
            {
                <div class="alert alert-warning">
                    No se encontraron libros con el título "@ViewBag.Buscar".
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    Todavía no hay libros registrados en el catálogo.
                </div>
            }
        }
    </div>
</div>
