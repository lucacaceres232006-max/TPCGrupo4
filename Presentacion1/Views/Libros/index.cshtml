@model List<Dominio.Libro>

@{
    ViewBag.Title = "Catálogo de libros";
}

<main class="container py-4" aria-labelledby="titulo-catalogo">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 id="titulo-catalogo">Catálogo de libros</h1>
            <p class="text-muted mb-0">Consultá los libros registrados en la biblioteca.</p>
        </div>
        <a href="@Url.Action("Create", "Libros")" class="btn btn-success">
            Registrar nuevo libro
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">
            <strong>Error:</strong> @TempData["Error"]
        </div>
    }

    <form action="@Url.Action("Index", "Libros")" method="get" class="mb-4" role="search">
        <label for="txtBuscar" class="visually-hidden">Buscar libro por título</label>
        <div class="input-group">
            <input type="text"
                   id="txtBuscar"
                   name="buscar"
                   class="form-control"
                   placeholder="Buscar libro por título..."
                   value="@ViewBag.Buscar" />

            <button type="submit" class="btn btn-primary">
                Buscar
            </button>

            <a href="@Url.Action("Index", "Libros")"
               class="btn btn-secondary">
                Limpiar búsqueda
            </a>
        </div>
    </form>

    <div class="row">
        @if (Model != null && Model.Count > 0)
        {
            foreach (var libro in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h2 class="card-title h4">@libro.Titulo</h2>

                            <p class="mb-1">
                                <strong>Autor:</strong>
                                @string.Join(", ", libro.Autores.Select(a => a.Nombre + " " + a.Apellido))
                            </p>

                            <p class="mb-1">
                                <strong>Género:</strong>
                                @string.Join(", ", libro.Categorias.Select(c => c.Descripcion))
                            </p>

                            <p class="mb-1">
                                <strong>Editorial:</strong>
                                @(libro.Editorial != null ? libro.Editorial.Nombre : "Sin editorial")
                            </p>

                            <p class="mb-1"><strong>Año:</strong> @libro.AnioEdicion</p>
                            <p class="mb-1"><strong>ISBN:</strong> @libro.ISBN</p>

                            <p class="mb-1">
                                <strong>Total de ejemplares:</strong>
                                @(libro.Ejemplares != null ? libro.Ejemplares.Count : 0)
                            </p>

                            <p class="mb-3">
                                <strong>Disponibles:</strong>
                                @(libro.Ejemplares != null
                                    ? libro.Ejemplares.Count(e => e.Estado == "Disponible")
                                    : 0)
                            </p>

                            <div class="mt-auto d-flex flex-wrap gap-2">
                                <a href="@Url.Action("Edit", "Libros", new { id = libro.Id })"
                                   class="btn btn-warning btn-sm"
                                   aria-label="Modificar libro @libro.Titulo">
                                    Modificar
                                </a>
                                <a href="@Url.Action("Delete", "Libros", new { id = libro.Id })"
                                   class="btn btn-danger btn-sm"
                                   aria-label="Eliminar libro @libro.Titulo"
                                   onclick="return confirm('¿Estás seguro de que querés eliminar el libro @libro.Titulo?');">
                                    Eliminar
                                </a>
                                <a href="@Url.Action("Details", "Libros", new { id = libro.Id })"
                                   class="btn btn-info btn-sm"
                                   aria-label="Ver detalle del libro @libro.Titulo">
                                    Ver detalle
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                @if (!string.IsNullOrEmpty(ViewBag.Buscar))
                {
                    <div class="alert alert-warning" role="status" aria-live="polite">
                        No se encontraron libros con el título "@ViewBag.Buscar".
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="status" aria-live="polite">
                        Todavía no hay libros registrados en el catálogo.
                    </div>
                }
            </div>
        }
    </div>
</main>