
@model List<Dominio.Autor>

@{
    ViewBag.Title = "Gestión de Autores";
}

<main class="container mt-4" aria-labelledby="titulo-pagina">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 id="titulo-pagina" class="h2">Catálogo de Autores</h1>
        <a href="@Url.Action("Create", "Autor")" class="btn btn-primary">
            Nuevo Autor
        </a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No hay autores registrados en el sistema actualmente.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle border">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Apellido</th>
                        <th>Nombre</th>
                        <th>Biografía</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <th scope="row">@item.Apellido</th>
                            <td>@item.Nombre</td>
                            <td>
                                @(string.IsNullOrWhiteSpace(item.Biografia) ? "Sin datos biográficos" : item.Biografia)
                            </td>
                            <td>
                                @if (item.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a href="@Url.Action("Edit", "Autor", new { id = item.Id })"
                                   class="btn btn-sm btn-outline-secondary">
                                    Editar
                                </a>

                                @if (item.Activo)
                                {
                                    using (Html.BeginForm("Desactivar", "Autor", new { id = item.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('¿Seguro que deseas desactivar este autor?');">
                                            Desactivar
                                        </button>
                                    }
                                }
                                else
                                {
                                    using (Html.BeginForm("Activar", "Autor", new { id = item.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            Activar
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
