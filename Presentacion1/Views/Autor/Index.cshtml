@model List<Dominio.Autor>

@{
    ViewBag.Title = "Gestión de Autores";
}

<main class="container mt-4" aria-labelledby="titulo-pagina">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 id="titulo-pagina" class="h2">Catálogo de Autores</h1>
        <a href="@Url.Action("Create", "Autor")" class="btn btn-primary">
            Nuevo Autor
        </a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info" role="status" aria-live="polite">
            No hay autores registrados en el sistema actualmente.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle border">
                <caption class="visually-hidden">Listado de autores registrados en la biblioteca con opciones para editar y eliminar</caption>
                <thead class="table-dark">
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Apellido</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Biografía</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <th scope="row" class="fw-semibold">@item.Apellido</th>
                            <td>@item.Nombre</td>
                            <td>
                                @(string.IsNullOrWhiteSpace(item.Biografia) ? "Sin datos biográficos" : item.Biografia)
                            </td>
                            <td class="text-end text-nowrap">
                                <a href="@Url.Action("Edit", "Autor", new { id = item.Id })"
                                   class="btn btn-sm btn-outline-secondary me-2"
                                   aria-label="Editar autor @item.Apellido, @item.Nombre">
                                    Editar
                                </a>
                                <a href="@Url.Action("Delete", "Autor", new { id = item.Id })"
                                   class="btn btn-sm btn-outline-danger"
                                   aria-label="Eliminar autor @item.Apellido, @item.Nombre">
                                    Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>