
@model List<Dominio.Libro>

@{
    ViewBag.Title = "Inicio";
}

<main class="container py-4">
    <section class="text-center mb-5">
        <h1 class="display-4">Biblioteca</h1>
        <p class="lead">Explorá nuestro catálogo de libros.</p>
    </section>

    <section>
        <h2 class="mb-4">Nuestros libros</h2>

        <div class="row g-4">
            @foreach (var libro in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h3 class="card-title">@libro.Titulo</h3>

                            <p class="card-text">
                                <strong>Autor:</strong>
                                @string.Join(", ", libro.Autores.Select(a => a.Nombre + " " + a.Apellido))
                            </p>

                            <p class="card-text">
                                <strong>Categoría:</strong>
                                @string.Join(", ", libro.Categorias.Select(c => c.Descripcion))
                            </p>

                            <p class="card-text">
                                <strong>Editorial:</strong> @libro.Editorial.Nombre
                            </p>

                            <p class="card-text">
                                <strong>Año de edición:</strong> @libro.AnioEdicion
                            </p>

                            <p class="card-text">
                                <strong>ISBN:</strong> @libro.ISBN
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
</main>
