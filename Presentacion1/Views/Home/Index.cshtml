@model List<Dominio.Prestamo>

@{
    ViewBag.Title = "Gestión de Préstamos";
}

<main class="container py-4" aria-labelledby="titulo-principal">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 id="titulo-principal">Panel de Préstamos y Circulación</h1>
            <p class="text-muted mb-0">Administrá los retiros, renovaciones y devoluciones de ejemplares de la biblioteca.</p>
        </div>
        <a href="@Url.Action("Create", "Home")" class="btn btn-success btn-lg">
            Registrar nuevo préstamo
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">
            <strong>Error:</strong> @TempData["Error"]
        </div>
    }

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success" role="status" aria-live="polite">
            @TempData["Exito"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="card-title h5 mb-3">Filtrar préstamos</h2>
            <form method="get" action="@Url.Action("Index", "Home")" role="search">
                <div class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <label for="txtBuscarPrestamo" class="form-label fw-semibold">Comprobante, socio, DNI, inventario o libro</label>
                        <input type="text"
                               id="txtBuscarPrestamo"
                               name="buscar"
                               class="form-control"
                               placeholder="Ej: COMP-00001, Pérez, 35123456, INV-FIC-001..."
                               value="@ViewBag.Buscar" />
                    </div>
                    <div class="col-md-3">
                        <label for="ddlFiltroEstado" class="form-label fw-semibold">Estado del préstamo</label>
                        <select id="ddlFiltroEstado" name="filtroEstado" class="form-control form-select">
                            <option value="Activos" @(ViewBag.FiltroEstado == "Activos" ? "selected" : "")>En curso (Activos)</option>
                            <option value="Vencidos" @(ViewBag.FiltroEstado == "Vencidos" ? "selected" : "")>Solo vencidos</option>
                            <option value="Devueltos" @(ViewBag.FiltroEstado == "Devueltos" ? "selected" : "")>Historial (Devueltos)</option>
                            <option value="Todos" @(ViewBag.FiltroEstado == "Todos" ? "selected" : "")>Todos los registros</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">Buscar</button>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary w-100">Limpiar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <caption class="visually-hidden">Listado de préstamos de ejemplares con comprobante, fechas de inicio, devolución prevista, estado y acciones</caption>
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Comprobante</th>
                        <th scope="col">Ejemplar / Libro</th>
                        <th scope="col">Socio</th>
                        <th scope="col">Inicio</th>
                        <th scope="col">Devolución prevista</th>
                        <th scope="col">Renovaciones</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            bool estaVencido = item.Estado == "Activo" && item.FechaPrevistaDevolucion.Date < DateTime.Today;
                            <tr class="@(estaVencido ? "table-danger" : "")">
                                <td class="fw-semibold">@item.NumeroComprobante</td>
                                <th scope="row">
                                    <div class="fw-semibold">@item.Ejemplar.TituloLibro</div>
                                    <small class="text-muted">Código: @item.Ejemplar.CodigoInventario</small>
                                </th>
                                <td>
                                    <div>@item.Socio.Apellido, @item.Socio.Nombre</div>
                                    <small class="text-muted">DNI: @item.Socio.DNI</small>
                                </td>
                                <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="@(estaVencido ? "fw-bold text-danger" : "")">
                                        @item.FechaPrevistaDevolucion.ToString("dd/MM/yyyy")
                                    </span>
                                </td>
                                <td>@item.CantidadRenovaciones / @item.Socio.PoliticaPrestamo.LimiteRenovaciones</td>
                                <td>
                                    @if (item.Estado == "Devuelto")
                                    {
                                        <span class="badge bg-secondary">
                                            Devuelto @(item.FechaDevolucionReal.HasValue ? "(" + item.FechaDevolucionReal.Value.ToString("dd/MM/yyyy") + ")" : "")
                                        </span>
                                    }
                                    else if (estaVencido)
                                    {
                                        <span class="badge bg-danger">Vencido</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Activo</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @if (item.Estado == "Activo")
                                    {
                                        if (!estaVencido && item.CantidadRenovaciones < item.Socio.PoliticaPrestamo.LimiteRenovaciones)
                                        {
                                            using (Html.BeginForm("Renovar", "Home", new { id = item.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                <button type="submit"
                                                        class="btn btn-warning btn-sm me-1"
                                                        aria-label="Renovar préstamo @item.NumeroComprobante de @item.Ejemplar.TituloLibro para @item.Socio.Apellido, @item.Socio.Nombre"
                                                        onclick="return confirm('¿Confirmás la renovación de este préstamo por @item.Socio.PoliticaPrestamo.DiasDuracion días más?');">
                                                    Renovar
                                                </button>
                                            }
                                        }

                                        <button type="button"
                                                class="btn btn-success btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalDevolucion"
                                                aria-label="Registrar devolución de @item.Ejemplar.TituloLibro (@item.Ejemplar.CodigoInventario) prestado a @item.Socio.Apellido, @item.Socio.Nombre"
                                                onclick="abrirModalDevolucion(@item.Id, '@item.Ejemplar.TituloLibro (@item.Ejemplar.CodigoInventario)', '@item.Socio.Apellido, @item.Socio.Nombre')">
                                            Devolver
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin acciones pendientes</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4" role="status" aria-live="polite">
                                No se encontraron préstamos para los criterios seleccionados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>

<div class="modal fade" id="modalDevolucion" tabindex="-1" aria-labelledby="tituloModalDevolucion" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("Devolver", "Home", FormMethod.Post))
            {
                <div class="modal-header">
                    <h2 class="modal-title h5" id="tituloModalDevolucion">Registrar devolución de ejemplar</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="hiddenIdPrestamoDevolucion" name="id" />
                    <p id="infoDevolucionTexto" class="fw-semibold"></p>

                    <div class="mb-3">
                        <label for="ddlEstadoDevolucion" class="form-label fw-semibold">
                            Estado en el que regresa el ejemplar *
                        </label>
                        <select id="ddlEstadoDevolucion" name="estadoEjemplar" class="form-control form-select" required>
                            <option value="Disponible">Disponible (En buen estado)</option>
                            <option value="En reparación">En reparación (Requiere arreglo físico)</option>
                            <option value="Extraviado">Extraviado / No devuelto</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="txtObservacionesDevolucion" class="form-label fw-semibold">
                            Observaciones sobre la devolución o estado físico (Opcional)
                        </label>
                        <textarea id="txtObservacionesDevolucion" name="observaciones" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Confirmar devolución</button>
                </div>
            }
        </div>
    </div>
</div>

<script src="~/Scripts/prestamos-buscador.js"></script>