@model Dominio.Socio

@{
    ViewBag.Title = "Modificar socio";
}

<main class="container py-4" aria-labelledby="titulo-editar-socio">
    <h1 id="titulo-editar-socio" class="h2">Modificar socio: @Model.Apellido, @Model.Nombre</h1>
    <hr />

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">
            <strong>Error al modificar el socio:</strong> @ViewBag.Error
        </div>
    }

    @using (Html.BeginForm("Edit", "Socios", FormMethod.Post))
    {
        @Html.HiddenFor(m => m.Id)

        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="txtNombre" class="form-label fw-semibold">
                    Nombre <span class="text-danger" aria-hidden="true">*</span>
                </label>
                <input type="text"
                       id="txtNombre"
                       name="Nombre"
                       class="form-control"
                       value="@Model.Nombre"
                       required
                       aria-required="true"
                       autocomplete="given-name" />
            </div>

            <div class="col-md-6 mb-3">
                <label for="txtApellido" class="form-label fw-semibold">
                    Apellido <span class="text-danger" aria-hidden="true">*</span>
                </label>
                <input type="text"
                       id="txtApellido"
                       name="Apellido"
                       class="form-control"
                       value="@Model.Apellido"
                       required
                       aria-required="true"
                       autocomplete="family-name" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="txtDni" class="form-label fw-semibold">
                    DNI <span class="text-danger" aria-hidden="true">*</span>
                </label>
                <input type="text"
                       id="txtDni"
                       name="DNI"
                       class="form-control"
                       value="@Model.DNI"
                       required
                       aria-required="true" />
            </div>

            <div class="col-md-6 mb-3">
                <label for="ddlPolitica" class="form-label fw-semibold">
                    Política de préstamo / Categoría <span class="text-danger" aria-hidden="true">*</span>
                </label>
                <select id="ddlPolitica" name="idPolitica" class="form-control form-select" required aria-required="true">
                    @if (ViewBag.Politicas != null)
                    {
                        foreach (var politica in ViewBag.Politicas)
                        {
                            bool seleccionada = Model.PoliticaPrestamo != null && Model.PoliticaPrestamo.Id == politica.Id;
                            <option value="@politica.Id" @(seleccionada ? "selected" : "")>
                                @politica.Descripcion (Máx. @politica.CantidadMaximaEjemplares libros, @politica.DiasDuracion días)
                            </option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label for="txtDireccion" class="form-label fw-semibold">Dirección</label>
            <input type="text"
                   id="txtDireccion"
                   name="Direccion"
                   class="form-control"
                   value="@Model.Direccion"
                   autocomplete="street-address" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="txtTelefono" class="form-label fw-semibold">Teléfono</label>
                <input type="text"
                       id="txtTelefono"
                       name="Telefono"
                       class="form-control"
                       value="@Model.Telefono"
                       autocomplete="tel" />
            </div>

            <div class="col-md-6 mb-3">
                <label for="txtEmail" class="form-label fw-semibold">Correo electrónico</label>
                <input type="email"
                       id="txtEmail"
                       name="Email"
                       class="form-control"
                       value="@Model.Email"
                       autocomplete="email" />
            </div>
        </div>

        <div class="form-check mb-4">
            <input class="form-check-input"
                   type="checkbox"
                   id="chkHabilitado"
                   name="Habilitado"
                   value="true"
                   @(Model.Habilitado ? "checked" : "") />
            <label class="form-check-label fw-semibold" for="chkHabilitado">
                Socio habilitado para retirar préstamos
            </label>
            <input type="hidden" name="Habilitado" value="false" />
        </div>

        <hr />

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a href="@Url.Action("Index", "Socios")" class="btn btn-secondary">Cancelar y volver al listado</a>
        </div>
    }
</main>