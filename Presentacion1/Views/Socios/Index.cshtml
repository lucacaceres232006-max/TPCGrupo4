@model List<Dominio.Socio>

@{
    ViewBag.Title = "Gestión de socios";
}

<main class="container py-4" aria-labelledby="titulo-socios">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 id="titulo-socios">Gestión de socios</h1>
            <p class="text-muted mb-0">Consultá y administrá el padrón de socios de la biblioteca.</p>
        </div>
        <a href="@Url.Action("Create", "Socios")" class="btn btn-success">
            Registrar nuevo socio
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">
            <strong>Error:</strong> @TempData["Error"]
        </div>
    }

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success" role="status" aria-live="polite">
            @TempData["Exito"]
        </div>
    }

    <form action="@Url.Action("Index", "Socios")" method="get" class="mb-4" role="search">
        <label for="txtBuscarSocio" class="visually-hidden">Buscar socio por nombre, apellido o DNI</label>
        <div class="input-group">
            <input type="text"
                   id="txtBuscarSocio"
                   name="buscar"
                   class="form-control"
                   placeholder="Buscar por nombre, apellido o DNI..."
                   value="@ViewBag.Buscar" />

            <button type="submit" class="btn btn-primary">
                Buscar
            </button>

            <a href="@Url.Action("Index", "Socios")"
               class="btn btn-secondary">
                Limpiar
            </a>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <caption class="visually-hidden">Listado de socios registrados con sus datos personales, condición de habilitación y política asignada</caption>
                <thead class="table-dark">
                    <tr>
                        <th scope="col">DNI</th>
                        <th scope="col">Apellidos y Nombres</th>
                        <th scope="col">Contacto</th>
                        <th scope="col">Política de préstamo</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var socio in Model)
                        {
                            <tr>
                                <th scope="row" class="fw-semibold">@socio.DNI</th>
                                <td>@socio.Apellido, @socio.Nombre</td>
                                <td>
                                    <div>@socio.Email</div>
                                    <small class="text-muted">@socio.Telefono</small>
                                </td>
                                <td>@(socio.PoliticaPrestamo != null ? socio.PoliticaPrestamo.Descripcion : "Sin política")</td>
                                <td>
                                    <span class="badge @(socio.Habilitado ? "bg-success" : "bg-danger")">
                                        @(socio.Habilitado ? "Habilitado" : "Suspendido")
                                    </span>
                                </td>
                                <td class="text-end text-nowrap">
                                    <a href="@Url.Action("Edit", "Socios", new { id = socio.Id })"
                                       class="btn btn-warning btn-sm me-1"
                                       aria-label="Modificar datos del socio @socio.Apellido, @socio.Nombre">
                                        Modificar
                                    </a>
                                    <a href="@Url.Action("Delete", "Socios", new { id = socio.Id })"
                                       class="btn btn-danger btn-sm"
                                       aria-label="Eliminar socio @socio.Apellido, @socio.Nombre"
                                       onclick="return confirm('¿Estás seguro de que querés eliminar al socio @socio.Apellido, @socio.Nombre?');">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4" role="status" aria-live="polite">
                                No se encontraron socios registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>