
@{
    ViewBag.Title = "Gestión de socios";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Gestión de socios</h1>
            <p class="text-muted">
                Consultá y administrá los socios de la biblioteca.
            </p>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title">Buscar socio</h5>

            <form method="get" action="@Url.Action("Index", "Socios")">
                <div class="row g-2">
                    <div class="col-md-9">
                        <input type="text"
                               name="buscar"
                               class="form-control"
                               placeholder="Buscar por nombre, apellido o DNI" />
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">
                            Buscar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Listado de socios</h2>
        <button type="button" class="btn btn-success" disabled>
            + Nuevo socio
        </button>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>DNI</th>
                        <th>Apellido y nombre</th>
                        <th>Teléfono</th>
                        <th>Correo electrónico</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td colspan="6" class="text-center py-4">
                            Todavía no hay socios cargados en esta pantalla.
                            <br />
                            <small class="text-muted">
                                El listado se conectará a la base de datos
                                cuando esté disponible la lógica de socios.
                            </small>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
