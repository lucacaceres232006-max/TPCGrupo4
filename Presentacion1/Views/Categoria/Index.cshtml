@model List<Dominio.Categoria>

@{
    ViewBag.Title = "Gestión de Géneros";
}

<main class="container mt-4" aria-labelledby="titulo-pagina">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 id="titulo-pagina" class="h2">Catálogo de Géneros Literarios</h1>
        <a href="@Url.Action("Create", "Categoria")" class="btn btn-primary">
            Nuevo Género
        </a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info" role="status" aria-live="polite">
            No hay géneros registrados en el sistema actualmente.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle border">
                <caption class="visually-hidden">Listado de géneros literarios registrados en la biblioteca con opciones para editar y eliminar</caption>
                <thead class="table-dark">
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Nombre del Género</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <th scope="row" class="fw-semibold">@item.Descripcion</th>
                            <td class="text-end text-nowrap">
                                <a href="@Url.Action("Edit", "Categoria", new { id = item.Id })"
                                   class="btn btn-sm btn-outline-secondary me-2"
                                   aria-label="Editar género @item.Descripcion">
                                    Editar
                                </a>
                                <a href="@Url.Action("Delete", "Categoria", new { id = item.Id })"
                                   class="btn btn-sm btn-outline-danger"
                                   aria-label="Eliminar género @item.Descripcion">
                                    Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>