
@model List<Dominio.Prestamo>
@using System.Collections.Generic

@{
    ViewBag.Title = "Préstamos y devoluciones";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>Préstamos y devoluciones</h1>
        <p class="text-muted">
            Consultá los préstamos registrados y sus fechas de vencimiento.
        </p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5">Buscar préstamo</h2>

            <form method="get" action="@Url.Action("Index", "Prestamos")">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label for="buscar" class="form-label">Socio o DNI</label>
                        <input type="text"
                               id="buscar"
                               name="buscar"
                               value="@ViewBag.Buscar"
                               class="form-control"
                               placeholder="Nombre, apellido o DNI" />
                    </div>

                    <div class="col-md-4">
                        <label for="estado" class="form-label">Estado</label>
                        <select id="estado" name="estado" class="form-select">
                            <option value="">Todos los estados</option>
                            <option value="Activo" @(ViewBag.Estado == "Activo" ? "selected" : "")>Activo</option>
                            <option value="Vencido" @(ViewBag.Estado == "Vencido" ? "selected" : "")>Vencido</option>
                            <option value="Devuelto" @(ViewBag.Estado == "Devuelto" ? "selected" : "")>Devuelto</option>
                        </select>
                    </div>

                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            Buscar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Listado de préstamos</h2>

        <a href="@Url.Action("Create", "Prestamos")" class="btn btn-success">
            + Registrar préstamo
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>N.º préstamo</th>
                        <th>Socio</th>
                        <th>Ejemplar</th>
                        <th>Fecha de préstamo</th>
                        <th>Vencimiento</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var prestamo in Model)
                        {
                            bool vencido = prestamo.Estado == "Activo" &&
                                prestamo.FechaPrevistaDevolucion.Date < DateTime.Today;

                            <tr>
                                <td>@prestamo.NumeroComprobante</td>

                                <td>
                                    @prestamo.Socio.Apellido, @prestamo.Socio.Nombre
                                    <br />
                                    <small class="text-muted">DNI: @prestamo.Socio.DNI</small>
                                </td>

                                <td>
                                    @prestamo.Ejemplar.CodigoInventario
                                    <br />
                                    <small class="text-muted">@prestamo.Ejemplar.TituloLibro</small>
                                </td>

                                <td>@prestamo.FechaInicio.ToString("dd/MM/yyyy")</td>

                                <td>@prestamo.FechaPrevistaDevolucion.ToString("dd/MM/yyyy")</td>

                                <td>
                                    @if (prestamo.Estado == "Devuelto")
                                    {
                                        <span class="badge bg-secondary">Devuelto</span>
                                    }
                                    else if (vencido)
                                    {
                                        <span class="badge bg-danger">Vencido</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                </td>
                                <td>
                                    @if (prestamo.Estado == "Activo")
                                    {
                                        <form method="post" action="@Url.Action("Devolver", "Prestamos")">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@prestamo.Id" />

                                            <input type="text"
                                                   name="observaciones"
                                                   class="form-control form-control-sm mb-2"
                                                   placeholder="Observaciones (opcional)" />

                                            <button type="submit" class="btn btn-warning btn-sm">
                                                Registrar devolución
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin acciones</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                No se encontraron préstamos.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
