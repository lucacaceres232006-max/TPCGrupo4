@model List<Dominio.Prestamo>
@using System.Collections.Generic

@{
    ViewBag.Title = "Préstamos y devoluciones";
}

<main class="container py-4" aria-labelledby="titulo-prestamos">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 id="titulo-prestamos">Préstamos y devoluciones</h1>
            <p class="text-muted mb-0">
                Consultá los préstamos registrados y sus fechas de vencimiento.
            </p>
        </div>

        <a href="@Url.Action("Create", "Prestamos")" class="btn btn-success">
            + Registrar préstamo
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">
            <strong>Error:</strong> @TempData["Error"]
        </div>
    }

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success" role="status" aria-live="polite">
            @TempData["Exito"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3">Buscar préstamo</h2>

            <form method="get" action="@Url.Action("Index", "Prestamos")" role="search">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label for="buscar" class="form-label fw-semibold">Comprobante, socio, DNI o ejemplar</label>
                        <input type="text"
                               id="buscar"
                               name="buscar"
                               value="@ViewBag.Buscar"
                               class="form-control"
                               placeholder="Comprobante, nombre, apellido, DNI o código" />
                    </div>

                    <div class="col-md-4">
                        <label for="estado" class="form-label fw-semibold">Estado</label>
                        <select id="estado" name="estado" class="form-select">
                            <option value="">Todos los estados</option>
                            <option value="Activo" @(ViewBag.Estado == "Activo" ? "selected" : "")>Activo</option>
                            <option value="Vencido" @(ViewBag.Estado == "Vencido" ? "selected" : "")>Vencido</option>
                            <option value="Devuelto" @(ViewBag.Estado == "Devuelto" ? "selected" : "")>Devuelto</option>
                        </select>
                    </div>

                    <div class="col-md-3 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary w-100">
                            Buscar
                        </button>
                        <a href="@Url.Action("Index", "Prestamos")" class="btn btn-secondary w-100">
                            Limpiar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <caption class="visually-hidden">Listado de préstamos con número de comprobante, socio, ejemplar, fechas, estado y acciones</caption>
                <thead class="table-dark">
                    <tr>
                        <th scope="col">N.º préstamo</th>
                        <th scope="col">Socio</th>
                        <th scope="col">Ejemplar</th>
                        <th scope="col">Fecha de préstamo</th>
                        <th scope="col">Vencimiento</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var prestamo in Model)
                        {
                            bool vencido = prestamo.Estado == "Activo" &&
                                prestamo.FechaPrevistaDevolucion.Date < DateTime.Today;

                            <tr class="@(vencido ? "table-danger" : "")">
                                <th scope="row" class="fw-semibold">@prestamo.NumeroComprobante</th>

                                <td>
                                    @prestamo.Socio.Apellido, @prestamo.Socio.Nombre
                                    <br />
                                    <small class="text-muted">DNI: @prestamo.Socio.DNI</small>
                                </td>

                                <td>
                                    @prestamo.Ejemplar.CodigoInventario
                                    <br />
                                    <small class="text-muted">@prestamo.Ejemplar.TituloLibro</small>
                                </td>

                                <td>@prestamo.FechaInicio.ToString("dd/MM/yyyy")</td>

                                <td>
                                    <span class="@(vencido ? "fw-bold text-danger" : "")">
                                        @prestamo.FechaPrevistaDevolucion.ToString("dd/MM/yyyy")
                                    </span>
                                </td>

                                <td>
                                    @if (prestamo.Estado == "Devuelto")
                                    {
                                        <span class="badge bg-secondary">Devuelto</span>
                                    }
                                    else if (vencido)
                                    {
                                        <span class="badge bg-danger">Vencido</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                </td>

                                <td class="text-end">
                                    @if (prestamo.Estado == "Activo")
                                    {
                                        <button type="button"
                                                class="btn btn-warning btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalDevolucion"
                                                aria-label="Registrar devolución del préstamo @prestamo.NumeroComprobante de @prestamo.Socio.Apellido, @prestamo.Socio.Nombre"
                                                onclick="prepararDevolucion(@prestamo.Id, '@prestamo.NumeroComprobante', '@prestamo.Ejemplar.CodigoInventario - @prestamo.Ejemplar.TituloLibro', '@prestamo.Socio.Apellido, @prestamo.Socio.Nombre')">
                                            Registrar devolución
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin acciones</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4" role="status" aria-live="polite">
                                No se encontraron préstamos.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="modal fade" id="modalDevolucion" tabindex="-1" aria-labelledby="tituloModalDevolucion" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                @using (Html.BeginForm("Devolver", "Prestamos", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="modal-header">
                        <h2 class="modal-title h5" id="tituloModalDevolucion">Registrar devolución</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" id="idPrestamoDevolucion" name="id" />
                        <p id="detallePrestamoDevolucion" class="fw-semibold mb-3"></p>

                        <div class="mb-3">
                            <label for="estadoEjemplar" class="form-label fw-semibold">Estado en el que regresa el ejemplar *</label>
                            <select id="estadoEjemplar" name="estadoEjemplar" class="form-select" required aria-required="true">
                                <option value="Disponible">Disponible (En buen estado)</option>
                                <option value="En reparación">En reparación</option>
                                <option value="Extraviado">Extraviado</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="observacionesDevolucion" class="form-label fw-semibold">Observaciones (opcional)</label>
                            <textarea id="observacionesDevolucion" name="observaciones" class="form-control" rows="3" placeholder="Detalle si el ejemplar presenta algún daño o novedad..."></textarea>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Confirmar devolución</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        function prepararDevolucion(id, comprobante, ejemplar, socio) {
            document.getElementById("idPrestamoDevolucion").value = id;
            document.getElementById("detallePrestamoDevolucion").textContent =
                "Comprobante " + comprobante + " — " + ejemplar + " (" + socio + ")";
            document.getElementById("estadoEjemplar").value = "Disponible";
            document.getElementById("observacionesDevolucion").value = "";
        }
    </script>
</main>