@model List<Dominio.Ejemplar>

@{
    ViewBag.Title = "Gestión de ejemplares";
}

<main class="container py-4" aria-labelledby="titulo-ejemplares">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 id="titulo-ejemplares">Gestión de ejemplares físicos</h1>
            <p class="text-muted mb-0">
                Consultá y administrá el inventario y estado físico de los ejemplares de la biblioteca.
            </p>
        </div>
        <a href="@Url.Action("Create", "Ejemplares")" class="btn btn-success">
            Registrar nuevo ejemplar
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">
            <strong>Error:</strong> @TempData["Error"]
        </div>
    }

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success" role="status" aria-live="polite">
            @TempData["Exito"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="card-title h5 mb-3">Buscar y filtrar ejemplares</h2>

            <form method="get" action="@Url.Action("Index", "Ejemplares")" role="search">
                <div class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <label for="txtBuscar" class="form-label fw-semibold">Código de inventario o título del libro</label>
                        <input type="text"
                               id="txtBuscar"
                               name="buscar"
                               class="form-control"
                               placeholder="Ej: INV-FIC-001 o Rayuela..."
                               value="@ViewBag.Buscar" />
                    </div>
                    <div class="col-md-3">
                        <label for="ddlEstado" class="form-label fw-semibold">Filtrar por estado</label>
                        <select id="ddlEstado" name="estado" class="form-control form-select">
                            <option value="">Todos los estados</option>
                            <option value="Disponible" @(ViewBag.EstadoSeleccionado == "Disponible" ? "selected" : "")>Disponible</option>
                            <option value="Prestado" @(ViewBag.EstadoSeleccionado == "Prestado" ? "selected" : "")>Prestado</option>
                            <option value="Reservado" @(ViewBag.EstadoSeleccionado == "Reservado" ? "selected" : "")>Reservado</option>
                            <option value="En reparación" @(ViewBag.EstadoSeleccionado == "En reparación" ? "selected" : "")>En reparación</option>
                            <option value="Extraviado" @(ViewBag.EstadoSeleccionado == "Extraviado" ? "selected" : "")>Extraviado</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">
                            Buscar
                        </button>
                        <a href="@Url.Action("Index", "Ejemplares")" class="btn btn-secondary w-100">
                            Limpiar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <caption class="visually-hidden">Inventario de ejemplares físicos con su libro asociado, estado de disponibilidad, observaciones y acciones</caption>
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Código de inventario</th>
                        <th scope="col">Título del libro</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Observaciones físicas</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var ejemplar in Model)
                        {
                            <tr>
                                <th scope="row" class="fw-semibold">@ejemplar.CodigoInventario</th>
                                <td>@ejemplar.TituloLibro</td>
                                <td>
                                    <span class="badge @(ejemplar.Estado == "Disponible" ? "bg-success" : ejemplar.Estado == "Prestado" ? "bg-primary" : ejemplar.Estado == "Reservado" ? "bg-info text-dark" : "bg-danger")">
                                        @ejemplar.Estado
                                    </span>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(ejemplar.Observaciones) ? "Sin observaciones" : ejemplar.Observaciones)</td>
                                <td class="text-end text-nowrap">
                                    <a href="@Url.Action("Edit", "Ejemplares", new { id = ejemplar.Id })"
                                       class="btn btn-warning btn-sm me-1"
                                       aria-label="Modificar ejemplar @ejemplar.CodigoInventario del libro @ejemplar.TituloLibro">
                                        Modificar
                                    </a>
                                    <a href="@Url.Action("Delete", "Ejemplares", new { id = ejemplar.Id })"
                                       class="btn btn-danger btn-sm"
                                       aria-label="Eliminar ejemplar @ejemplar.CodigoInventario del libro @ejemplar.TituloLibro"
                                       onclick="return confirm('¿Estás seguro de que querés eliminar el ejemplar @ejemplar.CodigoInventario?');">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4" role="status" aria-live="polite">
                                No se encontraron ejemplares registrados con los criterios seleccionados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>